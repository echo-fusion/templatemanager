{
    "name": "echo-fusion/templatemanager",
    "description": "Framework-independent template manager for EchoFusion: a built-in Twig/Smarty-style template language, plain PHP templates, and pluggable engines such as Twig through configuration.",
    "keywords": [
        "template",
        "templates",
        "view",
        "twig",
        "echofusion"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/templatemanager",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/templatemanager/issues",
        "source": "https://github.com/echo-fusion/templatemanager"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "echo-fusion/contracts": "^1.6",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^5.26",
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "twig/twig": "Required to use the TwigEngine adapter (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\TemplateManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EchoFusion\\TemplateManager\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check",
            "@analyze",
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "test:coverage:text": "vendor/bin/phpunit --coverage-text",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "psalm --show-info=false --no-cache --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
